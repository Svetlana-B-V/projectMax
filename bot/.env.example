# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Адрес веб-бэкенда «Общака» (без завершающего слэша)
BACKEND_URL=http://localhost:3000
BACKEND_TIMEOUT_SECONDS=10

# Локальная SQLite с состоянием бота (сессии, привязки чатов, дедупликация)
DB_PATH=bot_state.sqlite3

LOG_LEVEL=INFO

# Напоминания о долгах: не чаще раза в N часов; проверка раз в M секунд
REMINDER_INTERVAL_HOURS=24
REMINDER_CHECK_SECONDS=3600
